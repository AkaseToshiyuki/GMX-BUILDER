; NPT equilibration MDP — generated by GMXBUILDER
; {{ system_name | default('System') }}

integrator               = md
nsteps                   = {{ nsteps | default(50000) }}
dt                       = {{ dt | default(0.002) }}

; Output control
nstxout                  = {{ nstxout | default(5000) }}
nstvout                  = {{ nstvout | default(5000) }}
nstfout                  = {{ nstfout | default(0) }}
nstlog                   = {{ nstlog | default(1000) }}
nstenergy                = {{ nstenergy | default(1000) }}
nstxtcout                = {{ nstxtcout | default(5000) }}

; Neighbor searching
cutoff-scheme            = Verlet
ns-type                  = grid
nstlist                  = {{ nstlist | default(20) }}
pbc                      = {{ pbc | default('xyz') }}
rlist                    = {{ rlist | default(1.2) }}

; Electrostatics
coulombtype              = {{ coulombtype | default('PME') }}
rcoulomb                 = {{ rcoulomb | default(1.2) }}
fourierspacing           = {{ fourierspacing | default(0.12) }}

; van der Waals
vdwtype                  = Cut-off
vdw-modifier             = Force-switch
rvdw                     = {{ rvdw | default(1.2) }}

; Temperature coupling
tcoupl                   = {{ tcoupl | default('V-rescale') }}
tc-grps                  = {{ tc_grps | default('System') }}
tau-t                    = {{ tau_t | default(1.0) }}
ref-t                    = {{ ref_t | default(310.0) }}

; Pressure coupling
pcoupl                   = {{ pcoupl | default('C-rescale') }}
pcoupltype               = {{ pcoupl_type | default('isotropic') }}
tau-p                    = {{ tau_p | default(5.0) }}
ref-p                    = {{ ref_p | default(1.0) }}
compressibility          = {{ compressibility | default(4.5e-5) }}
refcoord-scaling         = com

; Constraints
constraints              = {{ constraints | default('h-bonds') }}
constraint-algorithm     = Lincs
continuation             = {{ continuation | default('yes') }}
