limit_req_zone $binary_remote_addr zone=gmxbuilder_api:10m rate=4r/s;

server {
    listen 443 ssl http2;
    server_name gmxbuilder.example.org;

    ssl_certificate /etc/letsencrypt/live/gmxbuilder.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gmxbuilder.example.org/privkey.pem;

    client_max_body_size 100m;

    location /health/live {
        proxy_pass http://127.0.0.1:7788;
    }

    location / {
        limit_req zone=gmxbuilder_api burst=20 nodelay;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://127.0.0.1:7788;
        proxy_read_timeout 3600s;
    }
}
