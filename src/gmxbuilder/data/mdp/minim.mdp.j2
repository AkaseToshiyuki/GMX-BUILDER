; Energy minimization MDP — generated by GMXBUILDER
; {{ system_name | default('System') }}

define                   = {{ define | default('-DFLEXIBLE') }}
integrator               = steep
nsteps                   = {{ nsteps | default(5000) }}
emtol                    = {{ emtol | default(1000.0) }}
emstep                   = {{ emstep | default(0.01) }}

; Output control
nstxout                  = {{ nstxout | default(0) }}
nstvout                  = {{ nstvout | default(0) }}
nstfout                  = {{ nstfout | default(0) }}
nstlog                   = {{ nstlog | default(100) }}
nstenergy                = {{ nstenergy | default(100) }}

; Neighbor searching
cutoff-scheme            = Verlet
ns-type                  = grid
nstlist                  = {{ nstlist | default(10) }}
pbc                      = {{ pbc | default('xyz') }}
rlist                    = {{ rlist | default(1.2) }}

; Electrostatics
coulombtype              = {{ coulombtype | default('PME') }}
rcoulomb                 = {{ rcoulomb | default(1.2) }}
fourierspacing           = {{ fourierspacing | default(0.12) }}

; van der Waals
vdwtype                  = Cut-off
vdw-modifier             = Force-switch
rvdw                     = {{ rvdw | default(1.2) }}

; Temperature coupling
tcoupl                   = no

; Pressure coupling
pcoupl                   = no

; Constraints
constraints              = {{ constraints | default('none') }}
constraint-algorithm     = Lincs
continuation             = no
